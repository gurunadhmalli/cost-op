# --- Database (PostgreSQL, free/self-hosted) ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_cost_db

# --- AI Assistant (Google Gemini API — FREE tier, no credit card) ---
# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=changeme
GEMINI_MODEL=gemini-2.5-flash

# --- Backend ---
JWT_SECRET=change-this-to-a-random-secret
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Simulator (stands in for real ERP/MES/IoT feeds) ---
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_SECONDS=30
